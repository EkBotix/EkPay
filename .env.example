# PUBLIC: shipped to the browser by design. Never place a service key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY: trusted key-management RPCs; never use a NEXT_PUBLIC prefix.
SUPABASE_SERVICE_ROLE_KEY=
# Stable high-entropy server-only HMAC pepper, at least 32 characters.
API_KEY_HASH_SECRET=
# Development only. Leave false on public/production deployments.
EKPAY_DEVELOPMENT_API_ENABLED=false
# Legacy synthetic fixture transport; NODE_ENV=test also mandatory.
EKPAY_SYNTHETIC_INGESTION_ENABLED=false
EKPAY_AUTO_VERIFY_SYNTHETIC_EVIDENCE=false
# Synthetic parser lifecycle only; hard-blocked in production; DB policy also default OFF.
EKPAY_PARSER_MANAGEMENT_ENABLED=false
EKPAY_PARSER_INGESTION_ENABLED=false
# Trusted canonical app origin; local example is not a secret.
APP_ORIGIN=http://localhost:3000
# Future encryption/signing configuration; not used by this phase.
KMS_KEY_REFERENCE=
WEBHOOK_SIGNING_VERSION=
